{
  "name": "dsh-labreport",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "基础物理实验报告自动生成：模板 + 指导书 + 书写要求 + 数据/图片 → 可编辑 Word 报告与 PDF（分步确认）",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "lab-report",
    "docx",
    "实验报告"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PolarVag/dsh-labreport-1122.git"
  },
  "homepage": "https://github.com/PolarVag/dsh-labreport-1122#readme",
  "bugs": {
    "url": "https://github.com/PolarVag/dsh-labreport-1122/issues"
  },
  "author": "dsh-labreport contributors",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "config.js",
    "lib",
    "engine",
    "vendor",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "node --check index.js && node --check config.js",
    "test": "python -m unittest discover -s engine/tests -v"
  }
}
